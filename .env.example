# Só é necessário em hospedagem com Node.js (VPS, Render, Railway, Docker, seu PC).
# No Netlify NÃO use arquivo: cadastre estas mesmas chaves em "Environment variables" (veja o guia).
# Copie para ".env" e NUNCA envie o .env para o GitHub.

NODE_ENV=production
PORT=3000

# Login único do painel /lista
ADMIN_USER=maisterdevcompany@gmail.com
# Gere com: npm run hash -- "sua senha forte"   (ou use o valor pronto do arquivo VARIAVEIS-PRIVADAS.txt)
ADMIN_PASSWORD_HASH=

# Chave longa e aleatória (32+ caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Segurança extra opcional: verificação em duas etapas (2FA). Gere com: npm run totp
ADMIN_TOTP_SECRET=

# Use 1 quando o site estiver atrás de proxy/CDN (Render, Railway, Nginx, Cloudflare...)
TRUST_PROXY=1
# Aceitar apenas seu domínio (recomendado em VPS). Ex.: mdbot.com,www.mdbot.com
ALLOWED_HOSTS=

# Onde os dados ficam (use disco/volume persistente na hospedagem)
DATA_DIR=./data
# Armazenamento: file (padrão) | upstash (Redis gratuito) | netlify (automático no Netlify)
STORAGE=file
# Só para STORAGE=upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SESSION_HOURS=8
MAX_UPLOAD_MB=100
